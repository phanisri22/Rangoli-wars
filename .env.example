# Copy to .env and change every value before deploying.

# Oracle: SYS/SYSTEM password and one password per service schema
ORACLE_PASSWORD=ChangeMe_Sys_2026
AUTH_DB_PASSWORD=ChangeMe_Auth_2026
LEADERBOARD_DB_PASSWORD=ChangeMe_Board_2026

# Shared by auth-service (signs tokens) and game-service (checks them). At least 32 characters.
JWT_SECRET=replace-with-a-long-random-string-of-48-chars

# Shared by game-service and leaderboard-service for /internal calls
INTERNAL_API_KEY=replace-with-another-long-random-string

# Login for the JSP admin page at /admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe_Admin_2026

# Port the site is served on
HTTP_PORT=80
