# syntax=docker/dockerfile:1.7
# One Dockerfile for every Java service: docker build --build-arg SERVICE=auth-service .
FROM eclipse-temurin:17-jdk AS build
ARG SERVICE
WORKDIR /src
COPY . .
RUN sed -i 's/\r$//' gradlew && chmod +x gradlew
RUN --mount=type=cache,target=/root/.gradle \
    ./gradlew :${SERVICE}:assemble -x test --no-daemon -q \
    && mkdir /out && cp ${SERVICE}/build/libs/app.* /out/

FROM eclipse-temurin:17-jre
RUN useradd --system --uid 1001 app
WORKDIR /app
COPY --from=build /out/ /app/
USER app
ENV JAVA_OPTS="-Xmx256m -XX:+UseSerialGC"
CMD ["sh", "-c", "exec java $JAVA_OPTS -jar /app/app.*"]
